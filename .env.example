# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# The public URL where the app is running. On Vercel, use https://phonekainy.vercel.app.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# UploadThing file-upload token from the UploadThing dashboard.
UPLOADTHING_TOKEN=""

# Auth.js session configuration. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Optional Google OAuth. The Google sign-in button appears when both values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe keys and the signing secret for the /api/webhooks endpoint.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Transactional email provider.
RESEND_API_KEY="re_..."
EMAIL_FROM="KainyCase <orders@example.com>"
EMAIL_FROM="KainyCase <orders@example.com>"

# Email address allowed to access the order dashboard.
ADMIN_EMAIL="owner@example.com"
