# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# The public URL where the app is running. Use http://localhost:3000 locally.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Kinde application credentials and redirect URLs.
KINDE_CLIENT_ID=""
KINDE_CLIENT_SECRET=""
KINDE_ISSUER_URL="https://YOUR_SUBDOMAIN.kinde.com"
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000/auth-callback"

# Stripe keys and the signing secret for the /api/webhooks endpoint.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Transactional email provider.
RESEND_API_KEY="re_..."

# Email address allowed to access the order dashboard.
ADMIN_EMAIL="owner@example.com"
